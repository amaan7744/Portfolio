# Copy to .env and fill in to enable the real LLM-backed portfolio assistant
# (server/assistant.js + server/providers/). Without any provider
# configured, the assistant still works — it falls back to the local
# keyword-retrieval engine (src/assistant/engine.js).

# Which provider to use. One of: groq (default), anthropic, openai, gemini.
# Only the corresponding *_API_KEY below needs to be set.
LLM_PROVIDER=groq

# --- Groq (default) --------------------------------------------------------
# Free tier, very low latency. Get a key at https://console.groq.com
GROQ_API_KEY=
# Optional — defaults to llama-3.3-70b-versatile. Other options:
# openai/gpt-oss-120b, qwen/qwen3-32b, deepseek-r1-distill-llama-70b
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Anthropic ---------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-5. Check https://docs.claude.com for
# the current model id before deploying.
# ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenAI --------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Gemini ----------------------------------------------------------------
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
